# Required: model and web-search providers
GROQ_API_KEY=
TAVILY_API_KEY=
# Optional backup and model selection
OPENROUTER_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
OPENROUTER_MODEL=openrouter/free
# Optional: web searches per answer, 1–12 (default 6)
# SOLO_MAX_SEARCHES=6
# Optional: privacy-conscious diagnostic reasons and latency/token counters in server logs
# SOLO_DIAGNOSTICS=1
# SOLO_PROFILE=1
# Optional: IANA time zone for interpreting dates (defaults to system time zone)
# TZ=Asia/Kolkata
